{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "squad-ik/endpoint-inventory",
  "title": "Endpoint Inventory",
  "description": "Every API endpoint of the legacy app, with golden request/response pairs captured from the RUNNING legacy app (step 01). The contract steps 05-09 and 20 are verified against.",
  "type": "object",
  "required": ["capturedAt", "endpoints"],
  "properties": {
    "capturedAt": { "type": "string", "description": "ISO-8601 timestamp of capture" },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method", "path", "auth", "goldens"],
        "properties": {
          "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
          "path": { "type": "string", "minLength": 1 },
          "auth": { "enum": ["public", "authenticated", "role-restricted"] },
          "roles": { "type": "array", "items": { "type": "string" } },
          "goldens": {
            "type": "array",
            "minItems": 1,
            "description": "Golden request/response pairs; response bodies with dynamic fields normalized.",
            "items": {
              "type": "object",
              "required": ["name", "requestFile", "responseFile", "status"],
              "properties": {
                "name": { "type": "string" },
                "requestFile": { "type": "string" },
                "responseFile": { "type": "string" },
                "status": { "type": "integer" },
                "normalizedFields": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
