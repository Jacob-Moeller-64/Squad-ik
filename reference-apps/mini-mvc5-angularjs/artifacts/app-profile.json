{
  "appName": "mini-mvc5-angularjs",
  "backend": {
    "flavor": "mvc5",
    "version": "5.2.3 on .NET Framework 4.8",
    "adapter": "adapters/backend/mvc5"
  },
  "frontend": {
    "flavor": "angularjs",
    "version": "1.8.2",
    "adapter": "adapters/frontend/angularjs"
  },
  "auth": {
    "mechanism": "forms-cookie",
    "notes": "Forms auth (web.config authentication mode=Forms, .ASPXAUTH cookie, demo/demo123 test user). Protected surface: GET /Orders/History ([Authorize], 302-redirects anonymous requests). This is the legacy scheme the Okta strangler (D-004) migrates."
  },
  "build": {
    "backend": "msbuild",
    "frontend": "none (script tags, vendored angular 1.8.2)"
  },
  "hazards": {
    "inProcSessionState": true,
    "localFileWrites": ["Controllers/OrdersController.cs: Server.MapPath(~/App_Data/orders.log)"],
    "windowsDependencies": []
  }
}
