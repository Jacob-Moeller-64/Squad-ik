<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Seeded 12-factor violation: hardcoded credentials in source control -->
    <add name="FieldServeDb"
         connectionString="Server=FSDB01;Database=FieldServe;User Id=fieldserve_app;password=F13ld$erve!"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Seeded logs-to-stdout violation: dispatch audit trail written to a local file -->
    <add key="AuditLogPath" value="~/App_Data/dispatch.log" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- Seeded statelessness violation: in-process session state -->
    <sessionState mode="InProc" timeout="20" />
    <!-- Legacy forms auth guarding /Invoices/Recent -->
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login" timeout="30" />
    </authentication>
    <machineKey validationKey="AutoGenerate,IsolateApps" decryptionKey="AutoGenerate,IsolateApps" />
  </system.web>
</configuration>
