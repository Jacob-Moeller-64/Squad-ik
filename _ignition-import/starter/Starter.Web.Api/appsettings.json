{
  "AllowedHosts": "*",
  "Fusion": {
    "Application": {
      // TODO: Replace with ID from Fusion App Management
      "Id": "00000000-0000-0000-0000-000000000000"
    },
    "Cache": {
      "Type": "Memory"
    },
    "DataDirectory": {
      "PathBase": "Starter"
    },
    "Security": {
      "Principal": {
        "CachePrincipalTransforms": true,
        "CacheUserProfiles": true,
        "IdentityProviders": [
          {
            "HttpClient": {
              "Name": "RequestBearerToken"
            },
            "IdentifierClaimIssuer": "[REDACTED-OKTA-TENANT-URL]",
            "Name": "Okta",
            "Type": "OktaOpenId",
            "UserIdClaimType": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier",
            "UserInfoUrl": "[REDACTED-OKTA-TENANT-URL]/oauth2/v1/userinfo",
            "UserProfileUrl": "[REDACTED-OKTA-TENANT-URL]/idp/myaccount/profile"
          }
        ],
        "TransformClaims": true
      },
      "Roles": [
        {
          "Identifiers": ["TestAdmin", "[REDACTED-APP-GROUP]"],
          "Role": "TestAdmin",
          "Type": "Group"
        },
        {
          "Identifiers": ["[REDACTED-AD-GROUP-ADMIN]"],
          "Role": "Admin",
          "Type": "Group"
        },
        {
          "Identifiers": ["[REDACTED-AD-GROUP-USER-1]", "[REDACTED-AD-GROUP-USER-2]"],
          "Role": "User",
          "Type": "Group"
        },
        {
          "Identifiers": ["[REDACTED-APP-GROUP]"],
          "Role": "[REDACTED-APP-GROUP]",
          "Type": "Group"
        },
        {
          "Role": "TestAdmin",
          "Type": "Authenticated"
        }
      ]
    },
    "Web": {
      "Api": {
        "EnableApi": true,
        "OpenApi": {
          "Title": "Starter API"
        }
      },
      "Client": {
        "Config": {
          "ApplicationConfig": {
            // Client config overrides here
          },
          "ApplicationName": "Starter",
          "ApplicationVersion": "1.0.0-DVL",
          "ConsoleLogLevel": "Debug",
          "FusionLogLevel": "Warning"
        }
      },
      "Cors": {
        "AllowedDomains": [
          "https://*.[REDACTED-CORP-DOMAIN-1]",
          "https://*.[REDACTED-CORP-DOMAIN-2]",
          "https://*.[REDACTED-CORP-DOMAIN-3]",
          "https://*.[REDACTED-CORP-DOMAIN-4]",
          "https://localhost", // android web view
          "capacitor://localhost", // ios web view
          "https://*.[REDACTED-OPENSHIFT-CLUSTER-HOST]"
        ]
      },
      "DominionEnergyDomains": [
        "[REDACTED-CORP-DOMAIN-1]",
        "[REDACTED-CORP-DOMAIN-2]",
        "[REDACTED-CORP-DOMAIN-3]",
        "[REDACTED-CORP-DOMAIN-4]",
        "localhost"
      ],
      "ForwardedHeaders": {
        "AllowedHosts": ["*.[REDACTED-CORP-DOMAIN-4]"],
        "ForwardedHeaders": "All",
        "KnownNetworks": [
          "[REDACTED-CIDR-1]",
          "[REDACTED-CIDR-2]",
          "[REDACTED-CIDR-3]",
          "[REDACTED-CIDR-4]",
          "[REDACTED-CIDR-5]",
          "[REDACTED-CIDR-6]"
        ]
      },
      "MaintenanceMode": {
        "IgnoreEndpoints": [
          {
            "Path": "/Fusion/CanBypassMaintenanceMode"
          },
          {
            "Path": "/Fusion/MaintenanceMode"
          }
        ],
        "IgnoreRoles": ["Admin"],
        "MaintenanceMode": false
      },
      "MaliciousInput": {
        "Enabled": true,
        "IgnoreEndpoints": [],
        "Values": [
          "<script",
          "<object",
          "<applet",
          "<embed",
          "<form",
          "<img",
          "javascript:",
          "<link",
          "<style",
          "<iframe",
          "<a",
          ".write(",
          "= document",
          "=document",
          "src%3dhttp",
          "src=\"http\"",
          ".addEventListener"
        ]
      },
      "PathBase": "/api",
      "RequestBodyBuffer": {
        "Enabled": true
      },
      "Security": {
        "Authorization": {
          "DefaultPolicy": {
            "RequiresAuthenticatedUser": true
          },
          "Policies": [
            {
              "Name": "TestAdmin",
              "RequiresAuthenticatedUser": true,
              "Roles": ["TestAdmin"]
            },
            {
              "Name": "Admin",
              "RequiresAuthenticatedUser": true,
              "Roles": ["Admin"]
            },
            {
              "Name": "User",
              "RequiresAuthenticatedUser": true,
              "Roles": ["User"]
            }
          ]
        },
        "IdentityProviders": [
          {
            "Options": {
              "Audience": "[REDACTED-OKTA-TENANT-URL]",
              "AuthorizationServerId": null, // so that the issuer is just the OktaDomain
              "ClientId": "[REDACTED-OKTA-CLIENT-ID]", // Fusion Prototype
              "OktaDomain": "[REDACTED-OKTA-TENANT-URL]"
            },
            "Type": "OAuth.OktaWebApi"
          }
        ]
      }
    }
  },
  "Logging": {
    // "FusionApi": {
    //   "Queue": {
    //     "ConsumerServiceCircuitBreakerDelay": "00:00:15:00",
    //     "Persistence": {
    //       "FileShare": "FusionLogQueue"
    //     },
    //     "PoisonOptions": {
    //       "PoisonType": "Consumer"
    //     },
    //     "SuppressLogs": true // Settings this to false could cause log loops.... but can be useful for log testing if necessary, just be sure to set the LogLevels appropriately
    //   },
    //   "QueueName": "FusionApiLogs"
    // },
    "LogLevel": {
      "Default": "Warning",
      "Fusion": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Starter.Library": "Trace",
      "Starter.Web.Api": "Trace"
    }
  }
}
